          { "name": "q", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Search keyword query string" }
        ],
        "responses": {
          "200": {
            "description": "Search results structured by resource type",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "projects": { "type": "array", "items": { "$ref": "#/components/schemas/Project" } },
                    "supportRequests": { "type": "array", "items": { "$ref": "#/components/schemas/SupportRequest" } },
                    "announcements": { "type": "array", "items": { "$ref": "#/components/schemas/Announcement" } }
                  }
                }
              }
            }
          },
          "500": { "description": "Server error processing search" }
        }
      }
    },
